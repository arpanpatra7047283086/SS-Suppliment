# MongoDB Atlas
# MONGODB_URI is already supplied by the connected MongoDB Atlas integration.
MONGODB_URI=
MONGODB_DB=ss-supplement

# Authentication
# Generate a unique random value (32+ characters): openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-character-random-secret
# The email used to access the admin dashboard.
ADMIN_EMAIL=admin@example.com
# Generate a bcrypt hash; never put the plain-text password here.
# Example: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Google Apps Script Email API
# Deploy the script as a Web App and paste its /exec URL here.
APPS_SCRIPT_EMAIL_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# Optional shared secret expected by your Apps Script endpoint.
APPS_SCRIPT_API_KEY=replace-if-your-script-requires-it

# Product image storage
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
